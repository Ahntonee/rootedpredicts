# ============================================================
# ROOTEDPREDICTIONS — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in all values
# NEVER commit .env to version control
# ============================================================

# --- APPLICATION ---
NODE_ENV=development
PORT=3000
SITE_URL=https://www.rootedpredictions.com
SITE_NAME=Rooted Predictions

# --- JWT ---
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# --- MYSQL DATABASE ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rootedpredictions
DB_USER=rootedpredictions_user
DB_PASSWORD=your_mysql_password
DB_CONNECTION_LIMIT=10

# --- API-FOOTBALL (api-football.com) ---
# Starter Plan: $19/month, 7,500 req/day, 1,200+ competitions
API_FOOTBALL_KEY=your_api_football_key_here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Free plan: set to 2024. When you upgrade to paid plan, change to 2025
API_FOOTBALL_SEASON=2024

# --- STRIPE (Primary global payment processor) ---
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Stripe Price IDs — create these in your Stripe dashboard
STRIPE_PRICE_MONTHLY=price_monthly_id_here
STRIPE_PRICE_QUARTERLY=price_quarterly_id_here
STRIPE_PRICE_ANNUAL=price_annual_id_here

# --- PAYSTACK (Secondary — African users) ---
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key

# --- EMAIL (SMTP for password reset, welcome emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@rootedpredictions.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=Rooted Predictions <noreply@rootedpredictions.com>

# --- TELEGRAM VIP ---
TELEGRAM_VIP_INVITE_LINK=https://t.me/+your_invite_hash

# --- RATE LIMITING ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- CRON SYNC ---
# Daily prediction sync time (cron format) — default: 6:00 AM UTC
SYNC_CRON_SCHEDULE=0 6 * * *
